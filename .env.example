# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Backend Configuration
PORT=3000
NODE_ENV=development
DATABASE_PATH=./server/database.sqlite
# REQUIRED for migrations: PostgreSQL connection string from Supabase
DATABASE_URL=postgres://user:password@host:port/database

# AI Service (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Redis (caching, rate limiting, deduplication)
# Use a managed Redis URL in prod (e.g. Upstash). Leave commented for local fallback.
# REDIS_URL=rediss://default:password@host:port

# Observability (optional)
# AI_TRACE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
MOCK_EMAIL=true
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Your Business Name

# File Upload
UPLOAD_DIR=./server/uploads
MAX_FILE_SIZE=5242880

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
DEV_BYPASS_TOKEN=set_a_random_token_here

# AI Limits
AI_RATE_LIMIT=10
AI_CACHE_TTL_HOURS=24

# IMPORTANT: in production this MUST be your frontend URL (e.g. https://your-app.vercel.app)
APP_URL=http://localhost:5174

# Notifications (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Production Deployment Notes:
# 1. Set NODE_ENV to "production"
# 2. Set DATABASE_URL to your Supabase/PostgreSQL connection string
# 3. Configure GEMINI_API_KEY in your hosting dashboard secrets — never commit it
# 4. Set MOCK_EMAIL to "false" and provide real SMTP credentials when ready
